{
  "name": "kuery",
  "version": "2.0.0",
  "description": "MongoDB-style in-memory query engine — zero dependencies, TypeScript, ESM+CJS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./collection": {
      "types": "./dist/collection.d.ts",
      "import": "./dist/collection.js",
      "require": "./dist/collection.cjs"
    },
    "./filter": {
      "types": "./dist/filter.d.ts",
      "import": "./dist/filter.js",
      "require": "./dist/filter.cjs"
    },
    "./compile": {
      "types": "./dist/compile.d.ts",
      "import": "./dist/compile.js",
      "require": "./dist/compile.cjs"
    },
    "./evaluate": {
      "types": "./dist/evaluate.d.ts",
      "import": "./dist/evaluate.js",
      "require": "./dist/evaluate.cjs"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js",
      "require": "./dist/trace.cjs"
    },
    "./operators": {
      "types": "./dist/operators.d.ts",
      "import": "./dist/operators.js",
      "require": "./dist/operators.cjs"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "import": "./dist/ast.js",
      "require": "./dist/ast.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./safe-path": {
      "types": "./dist/safe-path.d.ts",
      "import": "./dist/safe-path.js",
      "require": "./dist/safe-path.cjs"
    },
    "./expression": {
      "types": "./dist/expression.d.ts",
      "import": "./dist/expression.js",
      "require": "./dist/expression.cjs"
    }
  },
  "files": ["dist", "docs/adr/0001-standard-expression-core.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:expression-build": "node scripts/check-expression-build.mjs",
    "test:expression-types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/expression-public-types.mts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surikaterna/kuery.git"
  },
  "author": "Surikat AB",
  "license": "ISC",
  "devDependencies": {
    "ajv": "^8.17.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
