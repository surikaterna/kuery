{
  "name": "kuery",
  "version": "2.1.1",
  "description": "MongoDB-style in-memory query engine — TypeScript, ESM+CJS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./collection": {
      "import": { "types": "./dist/collection.d.ts", "default": "./dist/collection.js" },
      "require": { "types": "./dist/collection.d.cts", "default": "./dist/collection.cjs" }
    },
    "./filter": {
      "import": { "types": "./dist/filter.d.ts", "default": "./dist/filter.js" },
      "require": { "types": "./dist/filter.d.cts", "default": "./dist/filter.cjs" }
    },
    "./compile": {
      "import": { "types": "./dist/compile.d.ts", "default": "./dist/compile.js" },
      "require": { "types": "./dist/compile.d.cts", "default": "./dist/compile.cjs" }
    },
    "./evaluate": {
      "import": { "types": "./dist/evaluate.d.ts", "default": "./dist/evaluate.js" },
      "require": { "types": "./dist/evaluate.d.cts", "default": "./dist/evaluate.cjs" }
    },
    "./trace": {
      "import": { "types": "./dist/trace.d.ts", "default": "./dist/trace.js" },
      "require": { "types": "./dist/trace.d.cts", "default": "./dist/trace.cjs" }
    },
    "./operators": {
      "import": { "types": "./dist/operators.d.ts", "default": "./dist/operators.js" },
      "require": { "types": "./dist/operators.d.cts", "default": "./dist/operators.cjs" }
    },
    "./ast": {
      "import": { "types": "./dist/ast.d.ts", "default": "./dist/ast.js" },
      "require": { "types": "./dist/ast.d.cts", "default": "./dist/ast.cjs" }
    },
    "./errors": {
      "import": { "types": "./dist/errors.d.ts", "default": "./dist/errors.js" },
      "require": { "types": "./dist/errors.d.cts", "default": "./dist/errors.cjs" }
    },
    "./safe-path": {
      "import": { "types": "./dist/safe-path.d.ts", "default": "./dist/safe-path.js" },
      "require": { "types": "./dist/safe-path.d.cts", "default": "./dist/safe-path.cjs" }
    },
    "./expression": {
      "import": { "types": "./dist/expression.d.ts", "default": "./dist/expression.js" },
      "require": { "types": "./dist/expression.d.cts", "default": "./dist/expression.cjs" }
    }
  },
  "files": ["dist", "docs/adr/0001-standard-expression-core.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:expression-build": "node scripts/check-expression-build.mjs",
    "test:expression-types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/expression-public-types.mts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surikaterna/kuery.git"
  },
  "author": "Surikat AB",
  "license": "ISC",
  "devDependencies": {
    "ajv": "^8.17.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@kalada/core": "^0.1.0"
  }
}
